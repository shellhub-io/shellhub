---
import Callout from "./Callout.astro";

interface Props {
  /** Overrides the sentence, for a feature whose availability is not the usual pair. */
  title?: string;
}

const { title } = Astro.props;
---

<Callout
  variant="feature"
  title={title}
  action={{ href: "/about/editions", label: "See all editions" }}
>
  <slot>
    This feature is included with <strong>Cloud</strong> and <strong>Enterprise</strong>.
  </slot>
</Callout>
