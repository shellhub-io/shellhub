---
/**
 * A recorded interaction, framed like a screenshot.
 *
 * These were animated GIFs, which cost several megabytes each for a few seconds of a cursor
 * moving. The same recording as video is about a tenth of that and sharper, so a clip is a
 * muted, looping video that behaves like an image: it plays on its own and offers no controls.
 */
interface Props {
  name: string;
  alt: string;
}

const { name, alt } = Astro.props;
---
<figure class="clip">
  <video autoplay loop muted playsinline aria-label={alt}>
    <source src={`/img/manual/${name}.webm`} type="video/webm" />
    <source src={`/img/manual/${name}.mp4`} type="video/mp4" />
  </video>
</figure>

<style>
  .clip {
    margin: 1.75rem 0;
    background: rgb(var(--c-surface));
    border: 1px solid rgb(var(--c-border));
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .clip video {
    display: block;
    width: 100%;
  }
</style>
