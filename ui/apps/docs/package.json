{
  "name": "@shellhub/docs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run openapi && astro dev --force",
    "build": "npm run openapi && astro build && npm run check:links",
    "check:links": "node scripts/check-links.mjs dist",
    "openapi": "redocly bundle community-customer@v1 --config ../../../openapi/redocly.yaml -o public/openapi/community-openapi.yaml && redocly bundle cloud-customer@v1 --config ../../../openapi/redocly.yaml -o public/openapi/cloud-openapi.yaml && redocly bundle enterprise-customer@v1 --config ../../../openapi/redocly.yaml -o public/openapi/enterprise-openapi.yaml",
    "shots": "./scripts/capture-shots.sh",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "sync": "astro sync",
    "lint": "npm run lint:code && npm run lint:mdx",
    "lint:code": "eslint \"src/**/*.ts\"",
    "lint:mdx": "remark \"src/**/*.mdx\" --frail --quiet"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@shellhub/design-system": "*",
    "asciinema-player": "^3.17.0",
    "astro": "^7.2.10"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.5",
    "@types/jsdom": "^30.0.0",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-mdx-jsx-no-void-children": "^1.0.1",
    "remark-lint-mdx-jsx-unique-attribute-name": "^1.0.1",
    "remark-lint-no-duplicate-headings-in-section": "^4.0.1",
    "remark-lint-no-empty-url": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "yaml": "^2.9.1"
  }
}
