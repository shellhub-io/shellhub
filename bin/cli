#!/bin/sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
cd "$SCRIPT_DIR/.."

if ! ./bin/docker-compose ps --status running --services 2>/dev/null | grep -qx server; then
    echo "🚫 ERROR: ShellHub is not running. Exiting."
    exit 1
fi

TTY_FLAG=""
[ ! -t 1 ] && TTY_FLAG="-T"

exec ./bin/docker-compose exec $TTY_FLAG server /server admin "$@"
