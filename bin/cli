#!/bin/sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
cd "$SCRIPT_DIR/.."

if ! ./bin/docker-compose ps --status running --services 2>/dev/null | grep -qx server; then
    echo "🚫 ERROR: ShellHub is not running. Exiting."
    exit 1
fi

TTY_FLAG=""
[ ! -t 1 ] && TTY_FLAG="-T"

# The admin commands live in the server binary. In production /server is the
# built binary; in development it is a symlink to air's output.
exec ./bin/docker-compose exec $TTY_FLAG server /server admin "$@"
