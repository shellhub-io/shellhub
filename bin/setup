#!/bin/sh

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
cd "$SCRIPT_DIR/.."

. ./bin/lib/env.sh

instance_url() {
  public_url=$(env_var SHELLHUB_PUBLIC_URL "")
  if [ -n "$public_url" ]; then
    printf '%s' "${public_url%/}"
    return
  fi

  if [ "$(env_var SHELLHUB_AUTO_SSL false)" = "true" ]; then
    scheme=https
    port=$(env_var SHELLHUB_HTTPS_PORT 443)
    default_port=443
  else
    scheme=http
    port=$(env_var SHELLHUB_HTTP_PORT 80)
    default_port=80
  fi

  url="$scheme://$(env_var SHELLHUB_DOMAIN localhost)"
  [ "$port" = "$default_port" ] || url="$url:$port"
  printf '%s' "$url"
}

open_url() {
  url="$1"

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
    return
  fi

  if command -v open >/dev/null 2>&1; then
    open "$url"
    return
  fi

  if command -v x-www-browser >/dev/null 2>&1; then
    x-www-browser "$url" >/dev/null 2>&1 &
    return
  fi

  echo "🚀 Open this URL in your browser to complete setup: $url"
}

echo "🌟 Welcome to the ShellHub Setup Script"
echo ""

if ! ./bin/docker-compose ps --status running --services | grep -qx server; then
  echo "🚫 ERROR: ShellHub is not running. Exiting."
  exit 1
fi

URL=$(instance_url)

if curl -s --max-time 10 "$URL/info" | grep -q '"setup":true'; then
  echo "✅ Setup has already been completed. No further action is required."
  exit 0
fi

echo "📋 This script will open the setup URL for your ShellHub instance."
echo ""

echo "🔗 Generated Setup URL: $URL/setup"
open_url "$URL/setup"

echo ""
echo "✅ Please ensure your ShellHub server is running and reachable at $URL."
