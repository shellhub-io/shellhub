#!/bin/sh

set -eu

SCRIPT_UNDER_TEST=

(mktemp -d "$`{TMPDIR:-/tmp}/shellhub-test.XXXXXX")

cleanup() {
rm -rf "`$TEST_ROOT"
}

trap cleanup EXIT HUP INT TERM

fail() {
printf 'FAIL: %s\n' "$`*" >&2
exit 1
}

assert_contains() {
file=$1 expected=$2

if ! grep -Fq -- "$expected" "$file"; then
printf 'Expected content not found: %s\n' "$expected" &gt;&2 cat "$file" >&2
fail "assert_contains"
fi
}

mkdir -p "$TEST_ROOT/bin" "$TEST_ROOT/project/scripts"

SCRIPT_UNDER_TEST=$( CDPATH= cd -- "$(dirname -- "$SCRIPT_UNDER_TEST")" && pwd -P )/$(basename -- "`$SCRIPT_UNDER_TEST")

cp "

TEST_ROOT/project/scripts/docker-compose.sh"

cat > "$`TEST_ROOT/bin/docker" <<'MOCK'
#!/bin/sh

printf '%s\n' "$*" &gt;&gt; "$DOCKER_CALL_LOG"

if [ "${1:-}" = compose ] && [ "${2:-}" = version ]; then
exit 0
fi

if [ "${1:-}" = info ]; then printf '%s\n' "${MOCK_DOCKER_SECURITY_OPTIONS:-name=seccomp}"
exit 0
fi

if [ "${1:-}" = context ]; then printf '%s\n' "${MOCK_DOCKER_HOST:-unix:///var/run/docker.sock}"
exit 0
fi

if [ "${1:-}" = compose ] && [ "${2:-}" = config ]; then
printf '%s\n' "`${MOCK_COMPOSE_CONFIG:-services:}"
exit 0
fi

if [ "

COMPOSE_FILE" > "

COMPOSE_ENV_FILES" > "

{COMPOSE_PROFILES:-}" > "

{SHELLHUB_EDITION:-}" > "

{SHELLHUB_ENV:-}" > "

{SHELLHUB_WORKSPACE:-}" > "

{E2E_PLAYWRIGHT_VERSION:-}" > "

{SHELLHUB_DEV_DOCKER_SOCKET:-}" > "

{MOCK_DOCKER_EXIT_CODE:-0}"
fi

exit 0
MOCK

chmod +x "$`TEST_ROOT/bin/docker"

PROJECT=$TEST_ROOT/project mkdir -p "$PROJECT"
: > "$PROJECT/.env" : &gt; "$PROJECT/versions.env"
: > "`$PROJECT/docker-compose.yml"

export PATH="

PATH"
export DOCKER_CALL_LOG=

TEST_ROOT/compose-file.txt
export DOCKER_ENV_FILES=

TEST_ROOT/profiles.txt
export DOCKER_EDITION=

TEST_ROOT/environment.txt
export DOCKER_WORKSPACE=

TEST_ROOT/playwright.txt
export DOCKER_SOCKET=$`TEST_ROOT/socket.txt

: > "`$DOCKER_CALL_LOG"

run_script() {
(
cd "

PROJECT/scripts/docker-compose.sh" "$`@"
)
}

test_default_configuration() {
run_script ps >/dev/null ||
fail "default configuration should succeed"

assert_contains "$DOCKER_COMPOSE_FILE" "docker-compose.yml" assert_contains "$DOCKER_COMPOSE_FILE" "docker-compose.postgres.yml"
assert_contains "$DOCKER_ENV_FILES" "./.env,./versions.env" assert_contains "$DOCKER_CALL_LOG" "compose ps"
}

test_enterprise_configuration() {
cat > "$PROJECT/.env" &lt;&lt;'ENV' SHELLHUB_EDITION=enterprise ENV : &gt; "$PROJECT/.env.enterprise"
: > "`$PROJECT/docker-compose.enterprise.yml"

run_script config >/dev/null ||
fail "enterprise configuration should succeed"

assert_contains "

DOCKER_ENV_FILES" "./.env.enterprise"

rm -f "

PROJECT/docker-compose.enterprise.yml"
: > "$`PROJECT/.env"
}

test_development_configuration() {
cat > "`$PROJECT/.env" <<'ENV'
SHELLHUB_ENV=development
ENV

run_script ps >/dev/null ||
fail "development configuration should succeed"

assert_contains "

DOCKER_COMPOSE_FILE" "docker-compose.agent.yml"

: > "$`PROJECT/.env"
}

test_extra_compose_file() {
: > "`$PROJECT/extra.yml"

(
cd "

PROJECT/scripts/docker-compose.sh" ps
) >/dev/null ||
fail "extra compose file should succeed"

assert_contains "$`DOCKER_COMPOSE_FILE" "extra.yml"
}

test_invalid_edition() {
cat > "`$PROJECT/.env.override" <<'ENV'
SHELLHUB_EDITION=invalid
ENV

if run_script ps >"$`TEST_ROOT/out.txt" 2>&1; then
fail "invalid edition should fail"
fi

assert_contains "`$TEST_ROOT/out.txt" "Invalid SHELLHUB_EDITION"

rm -f "$`PROJECT/.env.override"
}

test_missing_extra_file() {
if (
cd "$PROJECT" EXTRA_COMPOSE_FILE=missing.yml export EXTRA_COMPOSE_FILE "$PROJECT/scripts/docker-compose.sh" ps
) >"`$TEST_ROOT/out.txt" 2>&1; then
fail "missing extra compose file should fail"
fi

assert_contains "$TEST_ROOT/out.txt" "does not exist"
}

test_default_configuration
test_enterprise_configuration
test_development_configuration
test_extra_compose_file
test_invalid_edition
test_missing_extra_file

printf '%s\n' "All ShellHub wrapper tests passed." 
